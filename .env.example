# Shared password for accessing the app
APP_PASSWORD=change-me

# Random secret for signing the auth cookie (run `openssl rand -hex 32`)
AUTH_SECRET=change-me-to-a-long-random-string

# Neon/Postgres connection string. On Vercel, this is injected automatically
# when you attach a Neon (Vercel Postgres) database to the project.
# For local dev, run `vercel env pull .env.local` after linking the project.
DATABASE_URL=
